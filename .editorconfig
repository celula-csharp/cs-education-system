# Configuración de nivel superior
root = true

# Configuración general para todos los archivos
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Archivos de texto
[*.{txt,md,xml,config,json,yml,yaml}]
indent_size = 2

# Archivos C#
[*.cs]

#### Estilo de código ####
# Identación
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Espaciado
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false

# Estilo de llaves
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

#### Convenciones de nomenclatura ####
# Usar camelCase para campos privados e internos
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Usar PascalCase para tipos, métodos y propiedades
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate, event, method, property

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

#### Reglas de análisis ####
# Calidad de código
dotnet_analyzer_diagnostic.category-security.severity = warning
dotnet_analyzer_diagnostic.category-performance.severity = warning
dotnet_analyzer_diagnostic.category-correctness.severity = warning

# Reglas específicas
dotnet_diagnostic.CA1822.severity = warning # Member does not access instance data
dotnet_diagnostic.CA1307.severity = warning # Specify StringComparison
dotnet_diagnostic.CA2007.severity = none # Consider calling ConfigureAwait
dotnet_diagnostic.CA2254.severity = warning # Template should be a static expression

# Configuraciones de lenguaje C#
csharp_using_directive_placement = inside_namespace:silent
csharp_prefer_simple_using_statement = true:silent
csharp_style_namespace_declarations = file_scoped:silent

# Nullable Reference Types
dotnet_diagnostic.CS8618.severity = warning # Non-nullable property is uninitialized

# Configuración específica para proyectos de API
[*/webSchool.Api/*.cs]
# Reglas adicionales para controladores y endpoints
dotnet_diagnostic.CA2007.severity = warning # Consider calling ConfigureAwait
dotnet_diagnostic.CA1822.severity = none # Permitir métodos no estáticos en controladores

# Configuración específica para proyectos de dominio
[*/webSchool.Domain/*.cs]
# Énfasis en inmutabilidad y claridad
csharp_style_prefer_readonly = true:suggestion

# Configuración específica para proyectos de infraestructura
[*/webSchool.Infrastructure/*.cs]
dotnet_diagnostic.CA2007.severity = suggestion # ConfigureAwait menos crítico